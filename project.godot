; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="full-haul"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/EventBus.gd"
ConfigLoader="*res://autoload/ConfigLoader.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/resizable=false
window/size/window_width_override=720
window/size/window_height_override=1260
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

## 全局默认字体（中文 OFL 字体内嵌；Web 导出无系统字体回退，必须自带）
theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/yard/plugin.cfg")

[fullhaul]

db/backend="memory"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

## Web 小游戏锁定（Godot 出 Web 仅支持 Compatibility）；纯 2D 项目无 Mobile 渲染器依赖
renderer/rendering_method="gl_compatibility"
